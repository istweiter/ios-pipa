@@ -834,3 +834,6 @@
 		((uint8_t *)page)[i] = mdt[i];
 	gpu_to_memory(page, round_page(size));
+	*header_va = page;
 	*phys = kvtophys(page);
+	printf("SWEET GPU: step 20: contiguous zap metadata at VA %#llx PA %#llx (%u bytes)\n", (unsigned long long)page,
+	    (unsigned long long)*phys, size);
@@ -2361,1 +2361,2 @@
-	uint64_t zap_header_pa = 0, zap_answer = ~0ull;
+	vm_offset_t zap_header_va = 0;
+	uint64_t zap_header_pa = 0, zap_answer = ~0ull;
@@ -2363,1 +2364,1 @@
-	if (!gpu_zap_header(zap_mdt, zap_mdt_size, &zap_header_pa))
+	if (!gpu_zap_header(zap_mdt, zap_mdt_size, &zap_header_va, &zap_header_pa))
@@ -2367,1 +2368,2 @@
 	    PAS_GPU, zap_header_pa, 0, &zap_answer);
+	kmem_free(kernel_map, zap_header_va, round_page(zap_mdt_size));
@@ -2370,3 +2372,5 @@
-	else
-		printf("SWEET GPU: step 20: TrustZone does not take the signature (returns %d, answer %#llx): a kernel before "
-		    "this one may already hold one\n", sig, (unsigned long long)zap_answer);
+	else {
+		printf("SWEET GPU: step 20: TrustZone rejected this zap signature (returns %d, answer %#llx); refusing to leave "
+		    "secure mode\n", sig, (unsigned long long)zap_answer);
+		goto collapse;
+	}
