 /*
+ * Pipa uses the two VIG pipes on the same CTL. Keep the inherited register
+ * configuration, including stride and format, and require both halves.
+ */
+static int
+pipa_flip_init(uint64_t fb_phys, uint32_t stride, uint32_t height, uint32_t *frame_stride,
+    uint64_t pa[3], vm_offset_t va[3])
+{
+	const uint32_t half_width = 900;
+	const uint32_t frame_height = 2880;
+	const uint64_t dma_limit = 0x100000000ull;
+	const void *prop = NULL;
+	unsigned int size = 0;
+	DTEntry chosen;
+	uint64_t pool[2];
+
+	if (fb_phys != DISPLAY_RESERVED_PHYS || stride != half_width * 2 * 4 || height != frame_height) {
+		printf("PIPA FLIP: unexpected splash geometry, keeping legacy presentation\n");
+		return 0;
+	}
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "pipa-scanout-pool", &prop, &size) != kSuccess ||
+	    size != sizeof(pool)) {
+		printf("PIPA FLIP: shim did not provide a scanout pool\n");
+		return 0;
+	}
+	memcpy(pool, prop, sizeof(pool));
+	uint64_t bytes = ((uint64_t)stride * height + PAGE_SIZE - 1) & ~(uint64_t)(PAGE_SIZE - 1);
+	uint64_t start = pool[0], length = pool[1];
+	if (start < 0x80000000ull || start >= dma_limit || (start & (PAGE_SIZE - 1)) ||
+	    length < 3 * bytes || length > dma_limit - start ||
+	    (start < fb_phys + DISPLAY_RESERVED_SIZE && fb_phys < start + length)) {
+		printf("PIPA FLIP: unusable scanout pool base=%#llx size=%#llx\n", start, length);
+		return 0;
+	}
+
+	mdp = ml_io_map_unmappable(MDP_PHYS, MDP_SIZE, VM_WIMG_IO);
+	intf = ml_io_map(INTF_PHYS, INTF_SIZE);
+	pipa_intf2 = ml_io_map(PIPA_INTF2_PHYS, INTF_SIZE);
+	if (!mdp || !intf || !pipa_intf2) {
+		printf("PIPA FLIP: display registers unavailable\n");
+		return 0;
+	}
+	for (unsigned int half = 0; half < 2; half++) {
+		vm_offset_t pipe = mdp + sspp_table[half].offset;
+		if (rd(pipe + SSPP_SRC0_ADDR) != fb_phys ||
+		    (rd(pipe + SSPP_SRC_YSTRIDE0) & 0xffff) != stride ||
+		    rd(pipe + SSPP_SRC_SIZE) != ((height << 16) | half_width) ||
+		    rd(pipe + SSPP_SRC_XY) != half * half_width ||
+		    rd(pipe + SSPP_SRC_FORMAT) != 0x237ff) {
+			printf("PIPA FLIP: unexpected VIG%u splash configuration\n", half);
+			return 0;
+		}
+		pipa_pipes[half] = pipe;
+	}
+	int ctl = -1;
+	for (int n = 0; n < CTL_COUNT; n++) {
+		ctl_base[n] = ml_io_map(CTL_PHYS + CTL_STRIDE * (uint32_t)n, CTL_SIZE);
+		vm_offset_t regs = ctl_base[n];
+		if (!regs) {
+			continue;
+		}
+		uint32_t active = rd(regs + CTL_INTF_ACTIVE);
+		uint32_t left = rd(regs + CTL_LAYER0) & CTL_PIPA_VIG_MASK;
+		uint32_t right = rd(regs + CTL_LAYER1) & CTL_PIPA_VIG_MASK;
+		printf("PIPA FLIP: ctl%d active=%#x layers=%#x/%#x\n", n, active, left, right);
+		/* Known ABL topology: mixer 0 VIG0 and mixer 1 VIG1 in the same stage. */
+		if ((active & CTL_PIPA_INTERFACES) == CTL_PIPA_INTERFACES &&
+		    left == 0x5 && right == 0x28) {
+			if (ctl >= 0) {
+				printf("PIPA FLIP: ambiguous split CTL\n");
+				return 0;
+			}
+			ctl = n;
+		}
+	}
+	if (ctl < 0 || smmu_blocks()) {
+		printf("PIPA FLIP: no shared CTL or display SMMU prevents physical scanout\n");
+		return 0;
+	}
+	for (int f = 0; f < 3; f++) {
+		pa[f] = start + (uint64_t)f * bytes;
+		va[f] = ml_io_map_unmappable((vm_offset_t)pa[f], (vm_size_t)bytes, VM_WIMG_WCOMB);
+		if (!va[f]) {
+			printf("PIPA FLIP: cannot map frame %d\n", f);
+			return 0;
+		}
+		pipa_frame_pa[f] = pa[f];
+	}
+	/* The retired initrd contains payload bytes until we initialize the frames. */
+	for (int f = 0; f < 3; f++) {
+		bzero((void *)va[f], (size_t)bytes);
+	}
+
+	ctl_driving = ctl;
+	flip_bit = (1u << sspp_table[0].flush_bit) | (1u << sspp_table[1].flush_bit);
+	pipe_stride = *frame_stride = stride;
+	pipa_separate = true;
+	ready = true;
+	printf("PIPA FLIP: three separate frames at %#llx, %llu bytes each, VIG0+VIG1 on CTL%d\n",
+	    start, bytes, ctl);
+	return 3;
+}
