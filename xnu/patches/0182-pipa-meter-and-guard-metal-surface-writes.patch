+	    args->scalarInput[0] > UINT32_MAX || args->scalarInput[1] > 1) {
+		return kIOReturnBadArgument;
+	}
+
+	OSObject *object = NULL;
+	IOReturn result = IOUserClient::copyObjectForPortNameInTask(fTask,
+	    (mach_port_name_t)args->scalarInput[0], &object);
+	SweetSurface *surface = OSDynamicCast(SweetSurface, object);
+	if (surface == NULL) {
+		OSSafeReleaseNULL(object);
+		return result == kIOReturnSuccess ? kIOReturnBadArgument : result;
+	}
+
+	bool begin = args->scalarInput[1] != 0;
+	IOLockLock(fLock);
+	if (fWriteClosed) {
+		IOLockUnlock(fLock);
+		object->release();
+		return kIOReturnNotOpen;
+	}
+	if (begin && fWriteRefs == NULL) {
+		fWriteRefs = OSArray::withCapacity(8);
+	}
+	if (fWriteRefs == NULL) {
+		result = begin ? kIOReturnNoMemory : kIOReturnNotFound;
+	} else {
+		unsigned index = 0;
+		SweetSurfaceRef *ref = NULL;
+		for (; index < fWriteRefs->getCount(); index++) {
+			SweetSurfaceRef *entry = (SweetSurfaceRef *)fWriteRefs->getObject(index);
+			if (entry->surface == surface) {
+				ref = entry;
+				break;
+			}
+		}
+		if (begin) {
+			result = kIOReturnNoMemory;
+			if (ref == NULL && index < SWEET_SURFACE_MAX_ID) {
+				SweetSurfaceRef *entry = new SweetSurfaceRef;
+				if (entry != NULL && entry->init() && sweet_surface_get(surface)) {
+					surface->retain();
+					entry->surface = surface;
+					if (fWriteRefs->setObject(entry)) {
+						ref = entry;
+					}
