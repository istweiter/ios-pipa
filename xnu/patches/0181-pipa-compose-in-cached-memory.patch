+{
+	uint64_t size = (uint64_t)bytesPerRow * height;
+	if (!width || !height || bytesPerRow < (uint64_t)width * 4 || size > SWEET_SURFACE_MAX_ALLOC) {
+		return NULL;
+	}
+	SweetSurface *s = sweet_surface_alloc_frame(width, height, bytesPerRow, pixelFormat);
+	if (s == NULL) {
