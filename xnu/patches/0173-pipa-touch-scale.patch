--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -774,6 +774,11 @@
 		if (id == 0 || id > TOUCH_MAX_FINGERS || (ev != 1 && ev != 2)) continue;
 		int x = (int)(((unsigned)p[1] << 4) | (p[3] >> 4)) + xoff;
 		int y = (int)(((unsigned)p[2] << 4) | (p[3] & 0x0fu)) + yoff;
+		int xmax = 1600, ymax = 2560;
+		(void)PE_parse_boot_argn("sweettouch_xmax", &xmax, sizeof(xmax));
+		(void)PE_parse_boot_argn("sweettouch_ymax", &ymax, sizeof(ymax));
+		if (xmax > 0) x = x * TOUCH_ABS_X / xmax;
+		if (ymax > 0) y = y * TOUCH_ABS_Y / ymax;
 		if (x < 0 || y < 0 || x >= TOUCH_ABS_X || y >= TOUCH_ABS_Y) continue;
 		unsigned idx = id - 1; now |= (1u << idx);
 		if (!(st.active & (1u << idx)) || st.x[idx] != x || st.y[idx] != y) { st.x[idx] = x; st.y[idx] = y; sweet_hid_touch((int)idx, 1, x, y); }
