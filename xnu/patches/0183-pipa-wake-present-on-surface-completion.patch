@@ -78,6 +78,48 @@
 static IOLock       *sweet_surface_lock;
 static uint32_t      pipa_surface_sync; /* 1 observes overlap, 2 excludes it */
 static uint64_t      pipa_begin_count, pipa_read_overlap, pipa_write_overlap;
+static uint64_t      pipa_present_epoch;
+
+static void
+pipa_surface_signal_locked(void)
+{
+	++pipa_present_epoch;
+	IOLockWakeup(sweet_surface_lock, &pipa_present_epoch, true);
+}
+
+uint64_t
+sweet_surface_present_epoch(void)
+{
+	if (pipa_surface_sync != 2) {
+		return 0;
+	}
+	IOLockLock(sweet_surface_lock);
+	uint64_t epoch = pipa_present_epoch;
+	IOLockUnlock(sweet_surface_lock);
+	return epoch;
+}
+
+void
+sweet_surface_present_wait(uint64_t epoch)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(34, NSEC_PER_MSEC, &deadline);
+	IOLockLock(sweet_surface_lock);
+	if (pipa_present_epoch == epoch) {
+		IOLockSleepDeadline(sweet_surface_lock, &pipa_present_epoch, deadline, THREAD_UNINT);
+	}
+	IOLockUnlock(sweet_surface_lock);
+}
+
+void
+sweet_surface_present_signal(void)
+{
+	if (pipa_surface_sync == 2) {
+		IOLockLock(sweet_surface_lock);
+		pipa_surface_signal_locked();
+		IOLockUnlock(sweet_surface_lock);
+	}
+}
 
